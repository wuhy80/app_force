[Unit]
Description=AppForce application proxy and management
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/local/bin/appforce --headless --autostart --data /var/lib/appforce --listen 127.0.0.1:17891
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
